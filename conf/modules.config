process {

    publishDir = [path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" }, mode: params.publish_dir_mode, enabled: false]

    withName: MULTIQC {
        publishDir = [path: { "${params.outdir}/reports" }, mode: params.publish_dir_mode, enabled: true, saveAs: { filename -> filename.equals('versions.yml') ? null : filename }]
    }
    withName: 'STAGE_SAMPLESHEET|CUSTOM_DUMPSOFTWAREVERSIONS' {
        publishDir = [path: { "${params.outdir}/pipeline_info" }, mode: params.publish_dir_mode, enabled: true, saveAs: { filename -> filename.equals('versions.yml') ? null : filename }]
    }
    withName: CUTADAPT_INSILICOPCR {
        publishDir = [path: { "${params.outdir}/raw/cutadapt" }, mode: params.publish_dir_mode, enabled: true, saveAs: { filename -> filename.equals('versions.yml') ? null : filename }]
    }
    withName: OBIPCR_INSILICOPCR {
        publishDir = [path: { "${params.outdir}/raw/obipcr" }, mode: params.publish_dir_mode, enabled: true, saveAs: { filename -> filename.equals('versions.yml') ? null : filename }]
    }
    withName: PARSE_OBIPCR {
        publishDir = [path: { "${params.outdir}/parsed_obipcr" }, mode: params.publish_dir_mode, enabled: true, saveAs: { filename -> filename.equals('versions.yml') ? null : filename }]
    }


    withName: VSEARCH_CLUSTER_FAST {
        ext.args = "--id ${params.cluster_id}"
        publishDir = [path: { "${params.outdir}/cluster_fast" }, mode: params.publish_dir_mode, enabled: true, saveAs: { filename -> filename.equals('versions.yml') ? null : filename }]
    }
    withName: CLUSTER_CONSENSUS {
        publishDir = [path: { "${params.outdir}/consensus" }, mode: params.publish_dir_mode, enabled: true, saveAs: { filename -> filename.equals('versions.yml') ? null : filename }]
    }

    withName: TAXONOMIC_COVERAGE {
        publishDir = [path: { "${params.outdir}/tax_coverage" }, mode: params.publish_dir_mode, enabled: true, saveAs: { filename -> filename.equals('versions.yml') ? null : filename }]
    }
    //
    withName: BUILD_DB_TAXIDS {
        publishDir = [path: { "${params.outdir}/build_db_taxids" }, mode: params.publish_dir_mode, enabled: true, saveAs: { filename -> filename.equals('versions.yml') ? null : filename }]
    }
    withName: TAXID_DB_FILTER {
        publishDir = [path: { "${params.outdir}/taxid_filtered" }, mode: params.publish_dir_mode, enabled: true, saveAs: { filename -> filename.equals('versions.yml') ? null : filename }]
    }
    withName: BLOCKLIST_FILTER {
        publishDir = [path: { "${params.outdir}/blocklist_filtered" }, mode: params.publish_dir_mode, enabled: true, saveAs: { filename -> filename.equals('versions.yml') ? null : filename }]
    }
    withName: CUSTOM_DB_FILTER {
        publishDir = [path: { params.hierarchical_clustering ? "${params.outdir}/hierarchical_clustering/filtered_db" : "${params.reference_base}/barbeque/${params.reference_version}/filtered/${meta.id}" }, mode: params.publish_dir_mode, enabled: params.hierarchical_clustering || (params.reference_base && !params.taxid && !params.blocklist), saveAs: { filename -> filename.equals('versions.yml') ? null : filename }]
    }
    withName: SPECIES_REPRESENTATION {
        publishDir = [path: { "${params.outdir}/tax_coverage" }, mode: params.publish_dir_mode, enabled: true, saveAs: { filename -> filename.equals('versions.yml') ? null : filename }]
    }
    withName: COMPLETENESS_TABLE {
        publishDir = [path: { "${params.outdir}/completeness" }, mode: params.publish_dir_mode, enabled: true, saveAs: { filename -> filename.equals('versions.yml') ? null : filename }]
    }

    withName: DB_DISTRIBUTION {
        publishDir = [path: { "${params.outdir}/db_distribution" }, mode: params.publish_dir_mode, enabled: true, saveAs: { filename -> filename.equals('versions.yml') ? null : filename }]
    }
    withName: AMPLICON_LENGTH {
        publishDir = [path: { "${params.outdir}/amplicon_lengths" }, mode: params.publish_dir_mode, enabled: true, saveAs: { filename -> filename.equals('versions.yml') ? null : filename }]
    }
    withName: JOIN_ACCESSION_TAXONOMY {
        publishDir = [path: { "${params.outdir}/join_accession_taxonomy" }, mode: params.publish_dir_mode, enabled: true, saveAs: { filename -> filename.equals('versions.yml') ? null : filename }]
    }
    withName: TAXONOMIC_COVERAGE_PLOT {
        publishDir = [path: { "${params.outdir}/taxonomic_coverage" }, mode: params.publish_dir_mode, enabled: true, saveAs: { filename -> filename.equals('versions.yml') ? null : filename }]
    }
    withName: 'COLLAPSE_PRIMERS|COLLAPSE_INPUT_PRIMERS' {
        publishDir = [path: { "${params.outdir}/collapsed_primers" }, mode: params.publish_dir_mode, enabled: true, saveAs: { filename -> filename.equals('versions.yml') ? null : filename }]
    }


    // --- Per-species divergence screening ---
    withName: SPLIT_AMPLICONS_BY_SPECIES {
        publishDir = [path: { params.hierarchical_clustering ? "${params.outdir}/hierarchical_clustering/species_fastas" : "${params.outdir}/species_split" }, mode: params.publish_dir_mode, enabled: true, saveAs: { filename -> filename.equals('versions.yml') ? null : filename }]
    }
    withName: VSEARCH_DEREPLICATION {
        publishDir = [path: { "${params.outdir}/hierarchical_clustering/dereplication" }, mode: params.publish_dir_mode, enabled: params.hierarchical_clustering, saveAs: { filename -> filename.equals('versions.yml') ? null : filename }]
    }
    withName: HCLUST_SPECIES {
        publishDir = [path: { params.hierarchical_clustering ? "${params.outdir}/hierarchical_clustering/species_divergence" : "${params.outdir}/species_divergence" }, mode: params.publish_dir_mode, enabled: true, saveAs: { filename -> filename.equals('versions.yml') ? null : filename }]
    }
    withName: FILTER_ACCESSIONS {
        publishDir = [path: { "${params.outdir}/filtered_amplicons" }, mode: params.publish_dir_mode, enabled: true, saveAs: { filename -> filename.equals('versions.yml') ? null : filename }]
    }
}
