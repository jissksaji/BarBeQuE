params {
    // SeqKit database filtering
    db_filter = false
    db_filter_pattern = "synthetic|artificial|construct|recombinant|transgenic|unverified|low[ ._-]?quality|contaminant|chimeric|misidentified|environmental"
    db_filter_min_length = 50
    db_filter_max_length = null
    db_filter_max_n = 10

    //flat file with taxonomy
    accession_taxonomy = null

    taxdump = null
    interactive = false

    //mask
    mask = false
    single_end = false
    //if single end is true then def 400 else 150
    read_length = params.single_end ? 400 : 150

    //obipcr
    obipcr_mismatches = 2
    obipcr_circular = false
    obipcr_include_primers = false
    obipcr_only_complete_flanking = false
    // Number of 3'-terminal bases of each primer that must match without mismatch.
    // Passed to obipcr by appending '#' to those bases; 0 disables the clamp.
    obipcr_fixed_3prime = 3


    input = null
    outdir = "${launchDir}/results"

    // Canonical target-taxa list used by every Streamlit analysis page. Keep this
    // in the repository so interactive runs do not depend on a manually copied
    // <outdir>/teeliste.tsv file.
    teeliste = "${baseDir}/res/teeliste.tsv"

    help = false
    helpFull = false

    run_name = null

    dbs = null
    custom_db = null

    // Accessions to discard after OBI-PCR parsing; one accession per line.
    accession_blocklist = null

    // Restrict --dbs/--custom_db to a single taxon (and its descendants) before anything else
    // runs against it, so just that taxon gets analysed/checked instead of the whole database.
    taxid = null

    primer_set = null

    // VSEARCH --cluster_fast identity threshold; override with --cluster_id on the command line.
    cluster_id = 0.97
    // Collapse identical post-PCR amplicons before clustering. Disabled to preserve
    // the existing one-input-record-per-cluster workflow by default.
    dereplicate_amplicons = false
    consensus_fraction = 1.0

    taxon = null


    build_references = false
    reference_base = null
    reference_version = "1.1"

    // Install both the NCBI taxdump and accession-to-taxid mapping together.
    install_taxdump = true


    primer_min = null
    primer_max = null

    // BLASTN vs. core_nt: restrict to a taxid, or leave null for an unrestricted search
    genbank_taxid = null

    plaintext_email = false
    //conda.enabled   = false
    singularity.enabled = false
    docker.enabled = false
    podman.enabled = false
    apptainer.enabled = false

    list_dbs = false
    list_primers = false
    midori_version = "271_2026-04-07"

    multiqc_config = "${baseDir}/conf/multiqc_config.yaml"
    multiqc_logo = "${baseDir}/assets/pipelinelogo.png"

    publish_dir_mode = 'copy'
    custom_config_base = "https://raw.githubusercontent.com/bio-raum/nf-configs/main"
}

manifest {
    name = "bio-raum/BarBeQuE"
    version = "0.6"
    description = "BarBeQuE"
    author = "MH"
    homePage = "https://github.com/bio-raum/BarBeQuE"
    nextflowVersion = ">=24.10.5"
}

process.shell = ['/bin/bash', '-euo', 'pipefail']

plugins {
    id 'nf-schema@2.7.2'
}

validation {
    help {
        enabled = true
    }
    defaultIgnoreParams = ["references", "multiqc_config", "multiqc_logo", "reference_version", "reference_sources", "obipcr_include_primers", "obipcr_circular", "obipcr_only_complete_flanking", "apptainer", "docker", "singularity", "podman", "conda", "custom_config_base", "publish_dir_mode", "plaintext_email", "midori_version"]
}

timeline {
    overwrite = true
    enabled = true
    file = "${params.outdir}/pipeline_info/pipeline_timeline.html"
}
report {
    overwrite = true
    enabled = true
    file = "${params.outdir}/pipeline_info/pipeline_report.html"
}
trace {
    overwrite = true
    enabled = true
    file = "${params.outdir}/pipeline_info/pipeline_trace.txt"
}
dag {
    overwrite = true
    enabled = true
    file = "${params.outdir}/pipeline_info/pipeline_dag.svg"
}

// Custom options for some modules
includeConfig 'conf/modules.config'
includeConfig 'conf/modules/installation.config'

// Load centrally stored profiles
includeConfig !System.getenv('NXF_OFFLINE') && params.custom_config_base ? "${params.custom_config_base}/custom.config" : "/dev/null"

// Default configs to load for all profiles
includeConfig 'conf/base.config'
includeConfig 'conf/reference_sources.config'
includeConfig 'conf/resources.config'

profiles {

    docker {
        docker.enabled = true
        singularity.enabled = false
        podman.enabled = false
        conda.enabled = false
        apptainer.enabled = false
        wave.enabled = true
        wave.strategy = ['conda']
        wave.build.template = 'conda/micromamba:v2'
    }
    singularity {
        docker.enabled = false
        podman.enabled = false
        conda.enabled = false
        apptainer.enabled = false
        singularity.enabled = true
        wave.enabled = true
        wave.freeze = true
        wave.strategy = ['conda']
    }
    podman {
        docker.enabled = false
        singularity.enabled = false
        conda.enabled = false
        apptainer.enabled = false
        podman.enabled = true
        wave.enabled = true
        wave.strategy = ['conda']
        wave.build.template = 'conda/micromamba:v2'
    }
    conda {
        docker.enabled = false
        podman.enabled = false
        singularity.enabled = false
        apptainer.enabled = false
        conda.enabled = true
    }
    apptainer {
        apptainer.enabled = true
        docker.enabled = false
        podman.enabled = false
        singularity.enabled = false
        conda.enabled = false
        wave.enabled = true
        wave.freeze = true
        wave.strategy = ['conda']
    }
    test {
        includeConfig 'conf/test.config'
    }
}
