params {
    //cutadapt default params
    //cutadapt_overlap = 18
    //cutadapt_error_rate = 0.12
    //cutadapt_options = ""
    cutadapt_mismatches = 2

    // Seqkit - Custom DB filtering
    custom_db_filter = false
    //custom_db_filter_pattern = "environmental|uncultured|metagenom|unidentified|unknown|unclassified|incertae[ ._-]?sedis|synthetic|artificial|construct|recombinant|transgenic|predicted|XM_|XR_|unverified|low[ ._-]?quality|contaminant|chimeric|misidentified"
    custom_db_filter_pattern = "synthetic|artificial|construct|recombinant|transgenic|unverified|low[ ._-]?quality|contaminant|chimeric|misidentified"
    custom_db_min_length = null
    custom_db_max_length = null
    custom_db_max_n = null

    //flat file with taxonomy
    accession_taxonomy = null

    taxdump = null
    interactive = false

    //pcr 
    insilico_tool = 'obipcr'

    //mask
    mask = false
    single_end = false
    //if single end is true then def 400 else 150
    read_length = params.single_end ? 400 : 150

    //obipcr
    obipcr_mismatches = 2
    obipcr_circular = false
    obipcr_include_primers = false
    obipcr_only_complete_flanking = false
    // Number of 3'-terminal bases of each primer that must match without mismatch.
    // Passed to obipcr by appending '#' to those bases; 0 disables the clamp.
    obipcr_fixed_3prime = 3


    input = null
    outdir = "${launchDir}/results"

    // Canonical target-taxa list used by every Streamlit analysis page. Keep this
    // in the repository so interactive runs do not depend on a manually copied
    // <outdir>/teeliste.tsv file.
    teeliste = "${baseDir}/res/teeliste.tsv"

    help = false
    helpFull = false

    run_name = null

    dbs = null
    custom_db = null

    // Remove database records assigned to taxids in FooDMe2's built-in blocklist
    blocklist = false

    // Restrict --dbs/--custom_db to a single taxon (and its descendants) before anything else
    // runs against it, so just that taxon gets analysed/checked instead of the whole database.
    taxid = null

    primer_set = null

    cluster_id = 0.97

    // Per-species divergence screening (advisory) — flags candidate misannotations before clustering.
    // Nothing is removed automatically; the author reviews the graph/BLAST and curates exclude_accessions.
    hierarchical_clustering = false
    // standalone custom DB per-species dereplication + hierarchical clustering workflow
    screen_species_divergence = false
    // run the per-species divergence analysis + graph
    species_divergence_id = 0.99
    // intra-species identity below which a sequence is flagged divergent
    species_hclust_method = 'average'
    // scipy.cluster.hierarchy linkage method
    species_hclust_max_seqs = 2000
    // skip hierarchical clustering for species above this many seqs
    exclude_accessions = null
    // author-maintained accession exclusion list (one per line) removed before clustering

    taxon = null
    completeness_table = null


    build_references = false
    reference_base = null
    reference_version = "1.1"

    // Install both the NCBI taxdump and accession-to-taxid mapping together.
    install_taxdump = true


    primer_min = null
    primer_max = null

    // BLASTN vs. core_nt: restrict to a taxid, or leave null for an unrestricted search
    genbank_taxid = null

    plaintext_email = false
    //conda.enabled   = false
    singularity.enabled = false
    docker.enabled = false
    podman.enabled = false
    apptainer.enabled = false

    list_dbs = false
    list_primers = false
    midori_version = "271_2026-04-07"

    multiqc_config = "${baseDir}/conf/multiqc_config.yaml"
    multiqc_logo = "${baseDir}/assets/pipelinelogo.png"

    publish_dir_mode = 'copy'
    custom_config_base = "https://raw.githubusercontent.com/bio-raum/nf-configs/main"
}

manifest {
    name = "bio-raum/BarBeQuE"
    version = "0.6"
    description = "BarBeQuE"
    author = "MH"
    homePage = "https://github.com/bio-raum/BarBeQuE"
    nextflowVersion = ">=24.10.5"
}

process.shell = ['/bin/bash', '-euo', 'pipefail']

plugins {
    id 'nf-schema@2.7.2'
}

validation {
    help {
        enabled = true
    }
    defaultIgnoreParams = ["references", "multiqc_config", "multiqc_logo", "reference_version"]
}

timeline {
    overwrite = true
    enabled = true
    file = "${params.outdir}/pipeline_info/pipeline_timeline.html"
}
report {
    overwrite = true
    enabled = true
    file = "${params.outdir}/pipeline_info/pipeline_report.html"
}
trace {
    overwrite = true
    enabled = true
    file = "${params.outdir}/pipeline_info/pipeline_trace.txt"
}
dag {
    overwrite = true
    enabled = true
    file = "${params.outdir}/pipeline_info/pipeline_dag.svg"
}

// Custom options for some modules
includeConfig 'conf/modules.config'
includeConfig 'conf/modules/installation.config'

// Load centrally stored profiles
includeConfig !System.getenv('NXF_OFFLINE') && params.custom_config_base ? "${params.custom_config_base}/custom.config" : "/dev/null"

// Default configs to load for all profiles
includeConfig 'conf/base.config'
includeConfig 'conf/reference_sources.config'
includeConfig 'conf/resources.config'

profiles {

    docker {
        docker.enabled = true
        singularity.enabled = false
        podman.enabled = false
        conda.enabled = false
        apptainer.enabled = false
    }
    singularity {
        docker.enabled = false
        podman.enabled = false
        conda.enabled = false
        apptainer.enabled = false
        singularity.enabled = true
    }
    podman {
        docker.enabled = false
        singularity.enabled = false
        conda.enabled = false
        apptainer.enabled = false
        podman.enabled = true
    }
    conda {
        docker.enabled = false
        podman.enabled = false
        singularity.enabled = false
        apptainer.enabled = false
        conda.enabled = true
    }
    apptainer {
        apptainer.enabled = true
        docker.enabled = false
        podman.enabled = false
        singularity.enabled = false
        conda.enabled = false
    }
    test {
        includeConfig 'conf/test.config'
    }
}
